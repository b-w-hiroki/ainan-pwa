  "styleGuardrails": {
    "preserve": [
      "sunlit saturated teal/blue ocean with convincing water depth and rippled highlights",
      "existing 2D illustrated player with clear silhouette, warm orange apparel and directional shading",
      "premium UI: glossy blue/gold fishing controls, compact light HUD, dark navy action dock",
      "gameplay-driven camera and large water playfield; fish/lure/line remain legible",
      "large fish presentation on Battle and Result without clipping, duplicate visuals or UI overlap",
      "current town/market/NPC art language and visible growth feedback"
    ],
    "reject": [
      "generic unrelated AI illustration style, muted stock-ocean look or photographic NPC pasted over illustrated player",
      "new whole-screen images replacing independent interactive layers",
      "flat uniform fish recolors presented as species-distinct finished artwork",
      "text or input hit areas baked into runtime decoration",
      "regressions of pull-and-release cast input, fish scale, water contrast or Result action hierarchy"
    ]
  },
